# Reference for ~/backup/env_files/backend_env. Preserve existing production
# secrets and database credentials; do not replace them with these placeholders.
DEBUG=0
SECRET_KEY=replace-with-existing-production-secret

# Keep the old domain only while the migration notice/API is in service.
ALLOWED_HOSTS=localhost 127.0.0.1 frontend backend pay-per.in www.pay-per.in pay-per.me www.pay-per.me
CORS_ALLOWED_ORIGINS=https://pay-per.in https://www.pay-per.in https://pay-per.me https://www.pay-per.me
CSRF_TRUSTED_ORIGINS=https://pay-per.in https://www.pay-per.in https://pay-per.me https://www.pay-per.me

DB_ENGINE=django.db.backends.postgresql
DB_NAME=replace-with-existing-database-name
DB_USER=replace-with-existing-database-user
DB_PASSWORD=replace-with-existing-database-password
DB_HOST=database
DB_PORT=5432
STATIC_URL=/static/

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=replace-with-existing-smtp-host
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=replace-with-existing-smtp-user
EMAIL_HOST_PASSWORD=replace-with-existing-smtp-password
