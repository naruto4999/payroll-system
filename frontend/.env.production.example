# Reference for ~/backup/env_files/frontend_env; deploy.sh applies these URLs.
# Keep frontend/.env configured for localhost when developing locally.
VITE_PUBLIC_URL=/
VITE_BACKEND_URL=/
VITE_FRONTEND_URL=https://pay-per.in/
# No trailing slash: employee photo paths already begin with /media/.
VITE_MEDIA_URL=https://pay-per.in
