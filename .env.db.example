# Reference for ~/backup/env_files/database_env. Keep the existing database's
# credentials; changing this file does not change users/passwords in its volume.
# These must match DB_NAME, DB_USER and DB_PASSWORD in the backend environment.
POSTGRES_DB=replace-with-existing-database-name
POSTGRES_USER=replace-with-existing-database-user
POSTGRES_PASSWORD=replace-with-existing-database-password
